<idea-plugin>
  <id>org.ca65</id>
  <name>6502 Assembly</name>
  <vendor email="michael.billington@gmail.com" url="http://github.com/mike42">Michael Billington</vendor>

  <description><![CDATA[
      This plugin provides basic support for 6502 assembly language. It is suitable for projects which use the ca65 assembler to target the WDC 65c02, 65c816, and related microprocessors.
    ]]></description>

  <!-- version, change-notes and idea-version (since/until build) are supplied by
       the Gradle build (intellijPlatform { pluginConfiguration { ... } }). -->

  <!-- please see https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html
       on how to target different products -->
  <depends>com.intellij.modules.platform</depends>

  <resource-bundle>messages.Asm6502Bundle</resource-bundle>

  <extensionPoints>
    <!-- Plugin-internal: emulator integrations register here so run/debug
         UI can filter by target system instead of listing every emulator. -->
    <extensionPoint qualifiedName="org.ca65.emulatorProvider"
                    interface="org.ca65.run.EmulatorProvider" dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="org.ca65">
    <emulatorProvider implementation="org.ca65.run.ViceEmulatorProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="6502 Assembly" implementationClass="org.ca65.AsmFileType" fieldName="INSTANCE"
              language="6502 Assembly" extensions="s;asm;inc;mac"/>
    <lang.parserDefinition language="6502 Assembly"
                           implementationClass="org.ca65.AsmParserDefinition"/>
    <lang.syntaxHighlighterFactory language="6502 Assembly"
                                   implementationClass="org.ca65.AsmSyntaxHighlighterFactory"/>
    <lang.psiStructureViewFactory language="6502 Assembly"
                                  implementationClass="org.ca65.AsmStructureViewFactory"/>
    <codeInsight.lineMarkerProvider language="6502 Assembly"
                                    implementationClass="org.ca65.AsmLineMarkerProvider"/>
    <lang.findUsagesProvider language="6502 Assembly"
                             implementationClass="org.ca65.AsmFindUsagesProvider"/>
    <gotoSymbolContributor
            implementation="org.ca65.AsmChooseByNameContributor"/>
    <lang.commenter language="6502 Assembly" implementationClass="org.ca65.AsmCommenter"/>
    <lang.foldingBuilder language="6502 Assembly"
                         implementationClass="org.ca65.AsmFoldingBuilder"/>
    <lang.formatter
            language="6502 Assembly"
            implementationClass="org.ca65.formatting.AsmFormattingModelBuilder"/>
    <completion.contributor language="6502 Assembly" implementationClass="org.ca65.AsmIdentifierCompletionContributor"/>
    <completion.contributor language="6502 Assembly" implementationClass="org.ca65.AsmMnemonicCompletionContributor"/>
    <completion.contributor language="6502 Assembly" implementationClass="org.ca65.AsmDotKeywordCompletionContributor"/>
    <completion.contributor language="6502 Assembly" implementationClass="org.ca65.AsmScopedMemberCompletionContributor"/>
    <annotator language="6502 Assembly" implementationClass="org.ca65.annotator.UnsupportedMnemonicAnnotator"/>
    <annotator language="6502 Assembly" implementationClass="org.ca65.annotator.AsmUnresolvedReferenceAnnotator"/>
    <annotator language="6502 Assembly" implementationClass="org.ca65.annotator.AsmUnusedReferenceAnnotator"/>
    <annotator language="6502 Assembly" implementationClass="org.ca65.annotator.AsmNumericLiteralAnnotator"/>
    <annotator language="6502 Assembly" implementationClass="org.ca65.annotator.AsmStarAssignAnnotator"/>
    <annotator language="6502 Assembly" implementationClass="org.ca65.annotator.AsmZilogHexAnnotator"/>
    <annotator language="6502 Assembly" implementationClass="org.ca65.annotator.AsmShortLabelRefAnnotator"/>
    <projectService serviceImplementation="org.ca65.config.AsmConfiguration" />
    <applicationService serviceImplementation="org.ca65.toolchain.Cc65ToolchainService" />
    <applicationConfigurable parentId="build" id="org.ca65.toolchains"
                             instance="org.ca65.toolchain.Cc65ToolchainConfigurable"
                             key="SETTINGS.toolchains.title" bundle="messages.Asm6502Bundle"/>
    <configurationType implementation="org.ca65.run.Ca65RunConfigurationType"/>
    <stepsBeforeRunProvider implementation="org.ca65.run.Ca65BuildBeforeRunTaskProvider"/>
    <xdebugger.breakpointType implementation="org.ca65.debugger.AsmLineBreakpointType"/>
    <programRunner implementation="org.ca65.debugger.Ca65DebugRunner"/>
    <statusBarWidgetFactory id="Asm6502Cpu"
                            implementation="org.ca65.status.AsmCpuStatusBarWidgetFactory"
                            order="after Encoding"/>
    <lang.documentationProvider language="6502 Assembly" implementationClass="org.ca65.AsmDocumentationProvider"/>
    <psi.referenceContributor language="6502 Assembly" implementation="org.ca65.AsmIncludeReferenceContributor"/>
    <codeInsight.declarativeInlayProvider language="6502 Assembly"
                                         implementationClass="org.ca65.AsmEnumValueInlayHintProvider"
                                         providerId="ca65.enumValues"
                                         group="VALUES_GROUP"
                                         isEnabledByDefault="true"
                                         bundle="messages.Asm6502Bundle"
                                         nameKey="INLAY.enum.values.name"/>

    <intentionAction>
      <className>org.ca65.action.ConvertNumberToHexadecimalIntentionAction</className>
      <bundleName>messages.Asm6502Bundle</bundleName>
      <categoryKey>INTN.category.asm6502</categoryKey>
    </intentionAction>
    <intentionAction>
      <className>org.ca65.action.ConvertNumberToDecimalIntentionAction</className>
      <bundleName>messages.Asm6502Bundle</bundleName>
      <categoryKey>INTN.category.asm6502</categoryKey>
    </intentionAction>
    <intentionAction>
      <className>org.ca65.action.ConvertNumberToBinaryIntentionAction</className>
      <bundleName>messages.Asm6502Bundle</bundleName>
      <categoryKey>INTN.category.asm6502</categoryKey>
    </intentionAction>
  </extensions>

  <projectListeners>
    <!-- The editor derives the assumed CPU from the selected run
         configuration; re-highlight when that selection changes. -->
    <listener class="org.ca65.run.Ca65RunConfigurationListener"
              topic="com.intellij.execution.RunManagerListener"/>
  </projectListeners>

</idea-plugin>
